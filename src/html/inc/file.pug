#file
  h1
    img(src="img/logo.png" alt="邳州麻将")
    if page == 'paipu'
      |  牌谱查看
  .version ver. #{version}
  
  .file.hide

    if page == 'index'
      a.start 人机对战（单机）
    if page == 'netplay'
      .error.hide
      .netplay
        .player-card
          img(src="img/icon.png" title="guest")
          span.name
        .room-actions
          form.room.join
            input(name="room_no" placeholder="输入房间号")
            input(type="submit" value="加入房间")
          form.room.create
            input(type="submit" value="创建房间")
        form.logout(method="POST" action="server/logout")
          input(type="submit" value="退出登录")

    if page == 'index' || page == 'netplay'
      .button
        a.stat
          img(src="img/icon-dotlist.png")
          | 牌譜集計
        |
        |
        a.download
          img(src="img/icon-download-alt.png")
          | 牌譜保存

    .list
      .row
        .button
          a.replay
            img(src="img/icon-play.png")
            | 再生
          |
          |
          a.edit
            img(src="img/icon-edit.png")
            | 編集
          |
          |
          a.download
            img(src="img/icon-download-alt.png")
            | 保存
          |
          |
          a.delete
            img(src="img/icon-trash.png")
            | 削除
          |
          |
          if page == 'paipu'
            span.move
              img(src="img/icon-resize-vertical.png")
        .content
          .title
          .player
          
    if page == 'paipu'
      .error.hide
      .loading.hide
        .blink 牌譜取得中......
      label.upload
        img(src="img/icon-upload-alt.png")
        | 牌譜追加
        input(type="file" multiple)
      label.storage
        input(name="storage" type="checkbox")
        | ローカルストレージ
      .button
        a.stat
          img(src="img/icon-dotlist.png")
          | 牌譜集計
        |
        |
        a.edit
          img(src="img/icon-edit.png")
          | 牌譜作成
        |
        |
        a.download
          img(src="img/icon-download-alt.png")
          | 牌譜保存
      form.tenhou.hide
        input(name="url" placeholder="天鳳 牌譜ID/URL")
        input(type="image" src="img/icon-squaresearch.png" alt="検索" align="top")
