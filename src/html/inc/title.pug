#title
  h1
    img(src="img/logo.png" alt="邳州麻将")
    | 邳州麻将
  if page == 'autoplay'
    div 自动对战
  .version ver. #{version}
  .loading Loading data...
  if page == 'index'
    .start.hide(tabindex="0" role="button") 人机对战（单机）
    a.netplay-link(href="netplay.html") 网络对战（联机）
  else
    .start.hide(tabindex="0" role="button") 开始游戏
  if page == 'netplay'
    .login.hide
      form.local(method="POST" action="auth/")
        input(name="name" placeholder="玩家名")
        input(name="passwd" value="*" type="hidden")
        input(type="submit" value="登录")
