#room
  h1
    img(src="img/logo.png" alt="邳州麻将")
    |  网络对战
  .version ver. #{version}
  
  form
    .room-head
      label 房间号
      input(name="room_no" value="" disabled)
      p.room-status
      input(type="button" name="quit" value="退出房间")
    ul.room
      li.user
        img(src="img/icon.png")
        span.name
        input.hide(type="button" name="quit" value="退出房间")
    .room-controls
      select(name="rule")
        option(value="") 邳州麻将规则
      input(name="timer" placeholder="限时（分钟）")
      input(type="submit" value="开始对局")
