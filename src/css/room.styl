body.room
    color: #eaf7f1
    background: linear-gradient(160deg, #12493a 0%, #0d3b2e 55%, #09281f 100%)
    min-height: 100vh
    margin: 0
    padding: 20px 10px 30px
    #navi
        margin: 0
    #room
        display: block
    > .version
        display: none

#room
    font-family: menu-font
    h1
        text-align: center
        font-size: 26px
        margin: 10px 0 6px
        color: #eaf7f1
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4)
        img
            height: 40px
            vertical-align: bottom
            margin-right: 4px
    > .version
        text-align: center
        font-size: 13px
        font-family: defen-font
        color: #6f8f80
        margin-top: -4px
        margin-bottom: 12px
    form
        background: rgba(8, 24, 19, 0.8)
        border: 1px solid rgba(232, 193, 90, 0.25)
        border-radius: 18px
        box-shadow: 0 10px 36px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.06)
        max-width: 560px
        margin: 0 auto
        padding: 26px 22px
    .room-head
        text-align: center
        label
            display: block
            color: #9fb8ac
            font-size: 13px
            letter-spacing: 0.3em
            margin-bottom: 6px
        input[name="room_no"]
            -webkit-text-fill-color: #f0d27a
            opacity: 1
            width: 7em
            font-size: 34px
            font-weight: bold
            font-family: defen-font
            text-align: center
            color: #f0d27a
            background: rgba(232, 193, 90, 0.1)
            border: 1px solid rgba(232, 193, 90, 0.35)
            border-radius: 12px
            padding: 8px 10px
            margin: 0 auto
            display: block
            box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.3)
        .room-status
            color: #e8c15a
            font-size: 15px
            margin: 12px 0 0
            min-height: 1.4em
    ul.room
        display: grid
        grid-template-columns: 1fr 1fr
        gap: 10px
        padding: 14px 0 6px
        margin: 0
        li.user
            list-style: none
            background: rgba(16, 44, 34, 0.9)
            border: 1px solid rgba(255, 255, 255, 0.08)
            border-radius: 12px
            padding: 14px 8px
            text-align: center
            transition: opacity 200ms ease-out, border-color 200ms ease-out
            &.offline
                img, .name
                    opacity: 0.3
                border-style: dashed
            img
                width: 38px
                height: 38px
                vertical-align: middle
                border-radius: 50%
                margin-right: 8px
                border: 2px solid rgba(232, 193, 90, 0.35)
            .name
                display: inline-block
                vertical-align: middle
                font-size: 16px
                max-width: 7em
                white-space: nowrap
                overflow: hidden
                text-overflow: ellipsis
            input[name="quit"]
                display: block
                margin: 8px auto 0
                background: rgba(255, 255, 255, 0.08)
                color: #9fb8ac
                border: 1px solid rgba(255, 255, 255, 0.15)
                border-radius: 6px
                padding: 3px 10px
                cursor: pointer
                font-family: menu-font
                &:hover
                    color: #f0d27a
                    border-color: rgba(232, 193, 90, 0.4)
    .room-controls
        display: flex
        flex-wrap: wrap
        gap: 10px
        justify-content: center
        align-items: center
        margin-top: 14px
        select
            padding: 9px 12px
            border-radius: 8px
            border: 1px solid rgba(232, 193, 90, 0.35)
            background: rgba(16, 44, 34, 0.9)
            color: #eaf7f1
            font-family: menu-font
            font-size: 14px
        input[name="timer"]
            width: 7em
            padding: 9px 12px
            border-radius: 8px
            border: 1px solid rgba(232, 193, 90, 0.35)
            background: rgba(16, 44, 34, 0.9)
            color: #eaf7f1
            font-family: menu-font
            font-size: 14px
        input[type="submit"]
            background: linear-gradient(180deg, #f0d27a, #e8c15a)
            color: #09281f
            border: none
            border-radius: 10px
            padding: 11px 28px
            font-size: 17px
            font-family: text-font
            letter-spacing: 0.15em
            cursor: pointer
            box-shadow: 0 4px 14px rgba(232, 193, 90, 0.3)
            transition: transform 160ms ease-out, filter 200ms ease-out
            &:hover
                filter: brightness(1.08)
            &:active
                transform: scale(0.97)

/* 退出房间按钮（房间号旁，等待/普通界面通用） */
#room form .room-head input[name="quit"]
    background: rgba(255, 255, 255, 0.08)
    color: #9fb8ac
    border: 1px solid rgba(255, 255, 255, 0.15)
    border-radius: 8px
    padding: 6px 12px
    cursor: pointer
    font-family: menu-font
    white-space: nowrap
    &:hover
        color: #f0d27a
        border-color: rgba(232, 193, 90, 0.4)

/* 等待开局：完整对局画面（计分板/牌河/座位），只是不发牌 */
body.board.waiting .shoupai
body.board.waiting .player-button
body.board.waiting .select-mianzi
    display: none
body.board.waiting #board > .board > .player
    background: rgba(16, 44, 34, 0.92)
    border: 1px solid rgba(232, 193, 90, 0.35)
    border-radius: 12px
    padding: 10px 16px
    opacity: 1
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35)
    .menfeng
        display: none
    .name
        color: #eaf7f1
        font-size: 16px
        max-width: 8em
        white-space: nowrap
        overflow: hidden
        text-overflow: ellipsis
body.board.waiting #room
    position: absolute
    z-index: 20
    top: 6%
    left: 50%
    transform: translateX(-50%)
    width: auto
    max-width: 92%
    margin: 0
    h1
        display: none
    > .version
        display: none
    form
        background: rgba(8, 24, 19, 0.88)
        border: 1px solid rgba(232, 193, 90, 0.3)
        border-radius: 14px
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.5)
        padding: 10px 24px
        margin: 0
        max-width: none
        display: flex
        align-items: center
        gap: 14px
        .room-head
            display: flex
            align-items: center
            gap: 10px
            label
                display: none
            input[name="room_no"]
                font-size: 24px
                font-weight: bold
                padding: 4px 10px
                width: auto
                margin: 0
                display: inline-block
                -webkit-text-fill-color: #f0d27a
                opacity: 1
                color: #f0d27a
                background: rgba(232, 193, 90, 0.1)
                border: 1px solid rgba(232, 193, 90, 0.35)
                border-radius: 8px
                text-align: center
            .room-status
                margin: 0
                font-size: 14px
        ul.room
            display: none
        .room-controls
            display: none

/* 进入牌桌时隐藏大厅/其他面板，避免叠层混乱 */
body.board #file
body.board #stat
body.board .version
    display: none

