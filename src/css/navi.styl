#navi
    font-size: 12px
    font-family: menu-font
    padding: 8px 0
    text-align: right
    li + li:before
        content: ' | '
        opacity: 0.3
    li
        display: inline-block
        a
            color: inherit
            text-decoration: none
            opacity: 0.75
            transition: opacity 150ms ease-out
            &:hover
                opacity: 1
                color: var(--jade-light)
