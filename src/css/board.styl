body.board
    color: white
    background: #050f0b
    margin: 0
    > *
        width: 800px
        margin: 0 auto
    #board
        display: block
    > .version
        display: block
        font-size: 16px
        font-family: defen-font
        text-align: right
#space
    display: none

#board
    display: none
#board > .board
    position: absolute
    width: 800px
    overflow: hidden
    user-select: none
    touch-action: manipulation
    margin: 0 auto
    background:
        radial-gradient(900px 500px at 50% 35%, #12493a 0%, #0d3b2e 50%, #09281f 100%)
    box-shadow: inset 0 0 120px rgba(0, 0, 0, 0.55)
    > *
        position: absolute
        transform-origin: 0% 0%
    .score
        border-radius: 10px
        background: rgba(8, 24, 19, 0.78)
        border: 1px solid rgba(232, 193, 90, 0.2)
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255,255,255,0.06)
        backdrop-filter: blur(4px)
        font-family: defen-font
        .juchang
            float: left
            .jushu
                font-family: title-font
                font-size: 32px
                line-height: 1.2
                color: #eaf7f1
        .shan
            float: right
            text-align: right
        .defen
            clear: both
            div
                position: absolute
                &.lunban
                    color: #0ff
                &.zhuang
                    color: #f0d27a
                &.main
                    text-align: center
                &.xiajia
                    text-align: right
                &.duimian
                    text-align: center
                &.shangjia
                    text-align: left
    .timer
        color: white
        font-size: 16px
        font-family: defen-font
        text-align: right
        text-shadow: 2px 2px 4px black
    .player-button
        z-index: 1
        text-align: right
        white-space: nowrap
        display: flex
        justify-content: end
        .button
            cursor: pointer
            display: inline-block
            text-align: center
            font-family: menu-font
            color: white
            background: rgba(20, 40, 33, 0.9)
            border: 1px solid rgba(232, 193, 90, 0.35)
            border-radius: 8px
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255,255,255,0.1)
            transition: transform 140ms var(--ease-out), background 160ms ease-out,
                        box-shadow 160ms ease-out
            &:hover
                background: #2a4a3d
                box-shadow: 0 3px 12px rgba(0, 0, 0, 0.45)
            &:active
                transform: scale(0.94)
            &:focus
                background: #3a5a4d
                outline: none
            &.kan-on
                background: rgba(232, 193, 90, 0.92)
                border-color: var(--gold)
                color: #09281f
                box-shadow: 0 2px 12px rgba(232, 193, 90, 0.4)
                &:hover
                    background: #f0d27a
                &:focus
                    background: #f0d27a
    .select-mianzi
        z-index: 1
        line-height: 1
        text-align: right
        white-space: nowrap
        .mianzi
            background: rgba(20, 40, 33, 0.92)
            border-radius: 8px
            border: 1px solid rgba(232, 193, 90, 0.35)
            cursor: pointer
            opacity: 0.92
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35)
            transition: transform 140ms var(--ease-out), opacity 160ms ease-out
            &:hover
                opacity: 1
            &:active
                transform: scale(0.96)
            &:focus
                outline: none
                opacity: 1.0
    > .player
        font-family: text-font
        white-space: nowrap
        overflow: hidden
        text-overflow: ellipsis
        transition: opacity 160ms ease-out, background 160ms ease-out
        .menfeng
            display: inline-block
            margin-right: 0.4em
            padding: 0 0.45em
            border-radius: 4px
            font-family: title-font
            font-size: 0.8em
            line-height: 1.4
            color: #09281f
            background: linear-gradient(160deg, #f0d27a, #e8c15a)
        .name
            overflow: hidden
            text-overflow: ellipsis
            vertical-align: middle
        &.disconnect
            opacity: 0.1
        &.selectable
            cursor: pointer
            &:hover
                opacity: 1
                background: rgba(30, 60, 48, 0.8)
    .say
        font-family: text-font
        color: white
        text-shadow: 3px  3px 6px #333,
                    -3px  3px 6px #333,
                    -3px -3px 6px #333,
                     3px -3px 6px #333
        transition: opacity 240ms var(--ease-out)
        &.main
            text-align: center
        &.xiajia
            text-align: left
        &.duimian
            text-align: center
        &.shangjia
            text-align: right
    .hule-dialog
        display: flex
        overflow: auto
        align-items: center
        transition: opacity 200ms var(--ease-out)
        &:focus
            outline: none
        > div
            margin: auto 0
            > div
                display: table
                background: rgba(10, 28, 22, 0.92)
                border: 1px solid rgba(232, 193, 90, 0.25)
                border-radius: 12px
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.55)
                backdrop-filter: blur(6px)
                margin: auto
                .hule
                    .shan
                        font-family: title-font
                        img
                            vertical-align: bottom
                        &.baopai
                            float: left
                        &.fubaopai
                            float: right
                    .shoupai
                        clear: both
                    .hupai
                        font-family: title-font
                        line-height: 1
                        .fanshu
                            text-align: right
                        .defen
                            text-align: right
                    .jicun
                        text-align: center
                        font-family: defen-font
                .pingju
                    font-family: title-font
                    text-align: center
                .fenpei
                    font-family: defen-font
                    > *
                        position: absolute
                        transform-origin: 0% 0%
                        display: inline-block
                        .player
                            display: none
                        .defen
                            display: inline-block
                            float: right
                            text-align: right
                        .diff
                            display: inline-block
                            float: right
                            text-align: right
                        .plus
                            color: #0ff
                        .minus
                            color: #f00
    > .summary
        z-index: 1
        display: flex
        overflow: auto
        align-items: center
        transition: opacity 200ms var(--ease-out)
        &:focus
            outline: none
        > div
            margin: auto 0
            > div
                background: rgba(10, 28, 22, 0.92)
                border: 1px solid rgba(232, 193, 90, 0.25)
                border-radius: 12px
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.55)
                backdrop-filter: blur(6px)
                margin: auto
                table
                    margin: auto
                    font-family: text-font
                    border-collapse: collapse
                    line-height: 1.5
                    .r_player
                        border-bottom: solid 2px
                    .r_diff
                        .back
                            text-align: right
                        .zhuangjia
                            background: rgba(232, 193, 90, 0.18)
                        .diff
                            font-family: defen-font
                        .lizhi
                            font-family: defen-font
                            display: inline-block
                            width: 1.2em
                            text-align: center
                    .r_defen
                        border-top: solid 2px
                        .defen
                            font-family: defen-font
                            text-align: right
                            padding-right: 1.2em
                    .r_point
                        border-top: solid 1px
                        .point
                            font-family: defen-font
                            text-align: center
                    .baojia
                    .minus
                        color: red
                    .hule
                    .plus
                        color: #0ff
                    a.download
                        opacity: 0.6
                        font-family: menu-font
                        font-size: 18px
                        text-decoration: none
                        color: white
                        &::link
                            color: white
                        img
                            height: 1em
                            vertical-align: text-bottom
    > .summary.paipu tbody tr:hover
        background: rgba(256,256,256,0.4)
        cursor: pointer
    .kaiju
        &:focus
            outline: none
    .kaiju > div
        z-index: 1
        margin-top: 120px
        position: relative
        width: 580px
        margin: auto
        background: rgba(10, 28, 22, 0.95)
        border: 1px solid rgba(232, 193, 90, 0.25)
        border-radius: 12px
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.55)
        backdrop-filter: blur(6px)
        .title
            margin: 40px 20px
            text-align: center
            font-family: title-font
            font-size: 32px
            line-height: 1
            color: #eaf7f1
        .player
            margin: 40px 20px
            height: 132px
            text-align: center
            font-family: text-font
            font-size: 24px
            .menfeng
                display: inline-block
                margin-right: 0.35em
                padding: 0 0.5em
                border-radius: 6px
                font-family: title-font
                font-size: 0.75em
                line-height: 1.5
                color: #09281f
                background: linear-gradient(160deg, #f0d27a, #e8c15a)
            > div
                position: absolute
                width: 240px
                height: 38px
                padding: 0px 10px
                border-radius: 8px
                background: rgba(32, 60, 50, 0.9)
                border: 1px solid rgba(255, 255, 255, 0.08)
                white-space: nowrap
                overflow: hidden
                text-overflow: ellipsis
                transition: background 160ms ease-out, transform 140ms var(--ease-out)
                &.selectable
                    cursor: pointer
                    &:hover
                        background: rgba(46, 204, 143, 0.6)
                    &:active
                        transform: scale(0.97)
                &.main
                    transform: translate(140px, 96px)
                &.xiajia
                    transform: translate(280px, 48px)
                &.duimian
                    transform: translate(140px, 0px)
                &.shangjia
                    transform: translate(0px, 48px)
    .suspend
        background: rgba(0, 0, 0, 0.5);

#board
    .controller
        position: absolute
        img
            display: none
            opacity: 0.2
            cursor: pointer
            &.sound
                display: inline
        &.paipu
            img
                display: inline
        .speed
            img
                display: inline
            span
                display: inline-block
                background: white
                opacity: 0.1
        &:hover
            border-color: #333
            background: black
            img
                opacity: 0.5
                &:hover
                    opacity: 1
            span
                opacity: 0.2
    .download
        position: absolute
        z-index: 1
        a
            opacity: 0.7
            display: inline-block
            color: white
            background: black
            text-decoration: none
            font-size: 18px
            font-family: menu-font
            padding: 6px 10px
            border-radius: 6px
            cursor: pointer
            img
                height: 1.2em
                margin-right: 0.5em
                vertical-align: middle
            &:hover
                opacity: 1
    .tenhou-dialog
        position: absolute
        z-index: 1
        background: rgba(0, 0, 0, 0.5);
        form
            padding: 15px
            background: white
            border-radius: 4px
            font-family: menu-font
            font-size: 14px
            color: black
            li
                display: inline-block
                margin-right: 0.5em
            textarea
                box-sizing: border-box
                width: 100%
                resize: none
                &.URL
                    white-space: pre
                &.JSON
                    word-break: break-all
            .button
                text-align: right

@media screen and (max-height: 680px)
    body.board
        height: 100dvh
        #space
            display: block
            background: #666
            height: 100px
        #navi, > .version
            display: none

@media screen and (max-width: 800px)
    body.board
        > .version
            display: none
