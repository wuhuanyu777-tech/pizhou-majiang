{
  "name": "pizhou-majiang",
  "version": "1.2.32",
  "description": "邳州麻将（查胡麻将）HTML5 游戏",
  "private": true,
  "scripts": {
    "build:html": "pug -o dist -P src/html/page/",
    "build:css": "stylus src/css/index.styl -o dist/css/majiang-1.2.32.css",
    "build:js": "webpack --mode development --devtool inline-source-map",
    "build": "npm run build:html && npm run build:css && npm run build:js",
    "release": "npm run build:html && npm run build:css && webpack --mode production",
    "clean": "rm -f dist/*.html dist/js/* dist/css/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kobalab/Majiang.git"
  },
  "keywords": [],
  "author": "Satoshi Kobayashi (https://github.com/kobalab)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kobalab/Majiang/issues"
  },
  "homepage": "https://github.com/kobalab/Majiang#readme",
  "overrides": {
    "pug": "^3.0.3"
  },
  "devDependencies": {
    "pug-cli": "^1.0.0-alpha6",
    "stylus": "^0.64.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@kobalab/majiang-ai": "file:src/majiang-ai",
    "@kobalab/majiang-core": "file:src/majiang-core",
    "@kobalab/majiang-ui": "file:src/majiang-ui",
    "jquery": "^3.7.1",
    "pizhou-majiang": "file:"
  }
}
